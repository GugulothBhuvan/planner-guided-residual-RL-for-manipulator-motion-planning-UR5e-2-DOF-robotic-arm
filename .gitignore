!results/runs/**/done.json
!results/runs/**/val.jsonl
!results/runs/**/alpha_sweep*.json
!results/runs/**/diagnostic*.json
!results/runs/**/failure_breakdown.*
!results/runs/*.log
!results/runs/pipeline_decisions.json
results/runs/**/checkpoints/
results/runs/**/logs*/
results/eval/logs/
*.tmp.*
.*.lock
*.part
